# Copy to .env before running docker compose: cp .env.example .env
# These credentials are local-development defaults. Change them for any shared or deployed
# environment; the database port is only published on 127.0.0.1.
POSTGRES_USER=energy
POSTGRES_PASSWORD=energy
POSTGRES_DB=energy
POSTGRES_PORT=5432

BACKEND_PORT=8000
# Browser origins allowed to call the API directly (comma-separated). The dashboard itself
# goes through the nginx proxy on the same origin; this is for e.g. the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

FRONTEND_PORT=3000

# Public Elexon Insights API; no key required.
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Re-download a dataset only if its last successful ingestion is older than this (0 = always).
INGEST_FRESHNESS_HOURS=24

# Used only when running the backend outside Docker.
DATABASE_URL=postgresql+psycopg://energy:energy@localhost:5432/energy
